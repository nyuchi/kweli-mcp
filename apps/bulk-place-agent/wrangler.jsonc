{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kweli-bulk-place-agent",
  "main": "src/index.ts",
  "account_id": "125a2dfbc21f76a25c980609609e8218",
  "compatibility_date": "2025-04-01",
  // mongodb driver + the Agents SDK both require the Node.js compat layer.
  "compatibility_flags": ["nodejs_compat"],

  // FundiAgent (per-task executor) is a Cloudflare Agent — a SQLite-backed
  // Durable Object. This worker owns the class + binding; nothing else binds
  // it directly — other callers (the Kweli MCP, or any Nyuchi/Mukoko app)
  // reach this worker only via its public POST /tasks (WorkOS M2M gated).
  "durable_objects": {
    "bindings": [{ "class_name": "FundiAgent", "name": "FUNDI_AGENT" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FundiAgent"]
    }
  ],

  // This worker is BOTH producer (POST /tasks, the cron sweeper) and
  // consumer of its own queue — unlike the earlier two-worker split, no
  // other worker needs producer access now that /tasks lives here.
  "queues": {
    "producers": [{ "queue": "fundi-ingestion-tasks", "binding": "TASK_QUEUE" }],
    "consumers": [
      {
        "queue": "fundi-ingestion-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "fundi-ingestion-tasks-dlq"
      }
    ]
  },

  // D1 task ledger — shared with apps/mcp (the Kweli MCP reads it for its
  // task_status/task_records tools). Create with
  // `wrangler d1 create fundi-ingestion-ledger` (already exists in
  // nyuchi/kweli's Cloudflare account — reuse that id).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fundi-ingestion-ledger",
      "database_id": "1ca0ed44-20fc-4cd5-a6c1-86b40daf1041",
      "migrations_dir": "migrations"
    }
  ],

  // OSM-id dedupe / rate-limit cache.
  "kv_namespaces": [{ "binding": "DEDUP_KV", "id": "7e726479ef2048c5b12e51bf1cc25141" }],

  // Workers AI: generate_description routes through the shamwari AI Gateway.
  "ai": { "binding": "AI" },

  // Hourly sweeper for failed/partial stragglers.
  "triggers": { "crons": ["0 * * * *"] },

  "routes": [{ "pattern": "fundi-bulk.nyuchi.dev", "custom_domain": true }],

  "observability": { "enabled": true },

  // Keep the mongodb driver's optional native add-ons (.node binaries) out of
  // the esbuild bundle; the driver runs fine without them.
  "alias": {
    "@mongodb-js/zstd": "./src/native-stub.js",
    "kerberos": "./src/native-stub.js",
    "mongodb-client-encryption": "./src/native-stub.js",
    "snappy": "./src/native-stub.js"
  },

  "vars": {
    "FUNDI_AI_MODEL": "workers-ai/@cf/moonshotai/kimi-k2.6",
    "FUNDI_AI_GATEWAY": "shamwari",
    "FUNDI_BOUNDARY_BBOX": "-36,-26,38,64",
    // WorkOS M2M — this agent's OWN dedicated application ("Nyuchi Fundi
    // Tester", org Nyuchi Africa; distinct from single-place-agent's
    // "Kweli" app). Callers authenticate as this client_id via
    // client_credentials; only the Nyuchi org may trigger bulk seeding.
    "WORKOS_AUTHKIT_DOMAIN": "https://identity.nyuchi.com",
    "WORKOS_M2M_CLIENT_ID": "client_01KSJT4TC5GW6RHTKMHB3C9500",
    "WORKOS_ALLOWED_ORG_IDS": "org_01KRDAB894DJF5V38PT5617TV1"
  },

  "dev": { "port": 8790 }
}
