{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kweli-mcp",
  "main": "src/index.ts",
  "account_id": "125a2dfbc21f76a25c980609609e8218",
  // Wrangler deletes every var not listed here on deploy, UNLESS keep_vars is
  // set — so this flag is what makes dashboard-managed configuration durable.
  // Without it, removing a value from `vars` means the next deploy wipes it.
  "keep_vars": true,

  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // KweliMcp (the MCP session surface) is a Cloudflare Agent — a
  // SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [{ "class_name": "KweliMcp", "name": "MCP_OBJECT" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KweliMcp"]
    }
  ],

  // Read-only from this worker's side: bulk-place-agent writes it,
  // task_status/task_records here just read it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fundi-ingestion-ledger",
      "database_id": "1ca0ed44-20fc-4cd5-a6c1-86b40daf1041"
    }
  ],

  // OAuth codes/tokens/state for @cloudflare/workers-oauth-provider.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "7b3cb31f73744a73a6f4aef9a0aff61c" }],

  // The two literal cross-worker bindings: seed_region/seed_admin_bulk call
  // bulk-place-agent, request_place calls single-place-agent. Both fetches
  // never leave Cloudflare's network — but each is still WorkOS M2M-gated on
  // the agent side, using THIS worker's own credentials (BULK_M2M_*,
  // SINGLE_M2M_* below), exactly like any other caller.
  "services": [
    { "binding": "BULK_PLACE_AGENT", "service": "kweli-bulk-place-agent" },
    { "binding": "SINGLE_PLACE_AGENT", "service": "kweli-single-place-agent" }
  ],

  // The Kweli MCP is a CONSUMER surface, so it serves from the consumer domain
  // under a path prefix — NOT from nyuchi.dev, which hosts internal tools only.
  // A zone route (not a custom domain) is what lets one hostname be shared:
  // `kweli.mukoko.com/mcp*` comes here, everything else stays with the Kweli
  // Next.js app. The prefix must stay in step with MCP_BASE_PATH (see
  // src/paths.ts) — this pattern is the only place the mount is hardcoded,
  // because Cloudflare resolves routes before the worker's env exists.
  //
  // Cutover prerequisites are listed in MIGRATION.md ("Serving from
  // kweli.mukoko.com/mcp") — the Next.js app currently answers this path.
  "routes": [{ "pattern": "kweli.mukoko.com/mcp*", "zone_name": "mukoko.com" }],

  "observability": { "enabled": true },

  "alias": {
    "@mongodb-js/zstd": "./src/native-stub.js",
    "kerberos": "./src/native-stub.js",
    "mongodb-client-encryption": "./src/native-stub.js",
    "snappy": "./src/native-stub.js"
  },

  // No vars in source: every value this worker needs is WorkOS identity
  // config, which differs per environment and is set as an environment
  // variable — see .dev.vars.example.

  "dev": { "port": 8789 }
}
