# Copy to `.dev.vars` for `wrangler dev` in this directory.
# Never commit the real file.
#
# EVERY WorkOS value below is an environment variable, deliberately NOT a
# literal in wrangler.jsonc. The 10 Aug 2026 issuer migration had to be chased
# through source in repo after repo precisely because these were hardcoded;
# Staging and Production are different WorkOS environments with different
# client IDs, so one baked-in value is wrong for at least one of them.
#
# In deployed environments set these on the Worker (dashboard or
# `wrangler secret put`). `keep_vars: true` in wrangler.jsonc is what stops a
# deploy from deleting them.

# The WorkOS issuer. `accounts` (plural) — `account.mukoko.com` is a different
# host. Production: https://accounts.mukoko.com
# Staging:    https://accounts-staging.mukoko.com
WORKOS_ISSUER="https://accounts.mukoko.com"

# This MCP's own interactive OAuth application.
WORKOS_CLIENT_ID="client_..."
WORKOS_ORGANIZATION_ID="org_..."
WORKOS_ALLOWED_ORG_IDS="org_..."
WORKOS_REQUIRED_PERMISSION="mongodb:access"

# Outbound M2M — one dedicated application per target agent. Never share a
# pair between agents; the audience check is what stops one agent's token
# opening the other.
BULK_M2M_CLIENT_ID="client_..."
BULK_M2M_CLIENT_SECRET="sk_..."
SINGLE_M2M_CLIENT_ID="client_..."
SINGLE_M2M_CLIENT_SECRET="sk_..."

COOKIE_ENCRYPTION_KEY="a-32-byte-random-string"
MONGODB_URI="mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority"
