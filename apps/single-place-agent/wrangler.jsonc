{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kweli-single-place-agent",
  "main": "src/index.ts",
  "account_id": "125a2dfbc21f76a25c980609609e8218",
  "compatibility_date": "2025-04-01",
  // The mongodb driver requires the Node.js compat layer.
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "class_name": "SinglePlaceAgent", "name": "SINGLE_PLACE_AGENT" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SinglePlaceAgent"]
    }
  ],

  "routes": [{ "pattern": "fundi-place.nyuchi.dev", "custom_domain": true }],

  "observability": { "enabled": true },

  // Keep the mongodb driver's optional native add-ons (.node binaries) out of
  // the esbuild bundle; the driver runs fine without them.
  "alias": {
    "@mongodb-js/zstd": "./src/native-stub.js",
    "kerberos": "./src/native-stub.js",
    "mongodb-client-encryption": "./src/native-stub.js",
    "snappy": "./src/native-stub.js"
  },

  "vars": {
    // WorkOS M2M — this agent's OWN dedicated application ("Kweli", org
    // Nyuchi Africa), distinct from bulk-place-agent's ("Kweli Fundi"). No
    // WORKOS_ALLOWED_ORG_IDS: any caller holding this client_id/secret pair
    // may call POST /tasks, regardless of org.
    "WORKOS_AUTHKIT_DOMAIN": "https://identity.nyuchi.com",
    "WORKOS_M2M_CLIENT_ID": "client_01KZG8V8VVS6268W1ERMW7YBNE"
  },

  "dev": { "port": 8792 }
}
