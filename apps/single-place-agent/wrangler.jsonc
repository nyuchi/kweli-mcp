{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kweli-single-place-agent",
  "main": "src/index.ts",
  "account_id": "125a2dfbc21f76a25c980609609e8218",
  // Wrangler deletes every var not listed here on deploy, UNLESS keep_vars is
  // set — so this flag is what makes dashboard-managed configuration durable.
  // Without it, removing a value from `vars` means the next deploy wipes it.
  "keep_vars": true,

  "compatibility_date": "2025-04-01",
  // The mongodb driver requires the Node.js compat layer.
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "class_name": "SinglePlaceAgent", "name": "SINGLE_PLACE_AGENT" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SinglePlaceAgent"]
    }
  ],

  "routes": [{ "pattern": "fundi-place.nyuchi.dev", "custom_domain": true }],

  "observability": { "enabled": true },

  // Keep the mongodb driver's optional native add-ons (.node binaries) out of
  // the esbuild bundle; the driver runs fine without them.
  "alias": {
    "@mongodb-js/zstd": "./src/native-stub.js",
    "kerberos": "./src/native-stub.js",
    "mongodb-client-encryption": "./src/native-stub.js",
    "snappy": "./src/native-stub.js"
  },

  // No vars in source: every value this worker needs is WorkOS identity
  // config, which differs per environment and is set as an environment
  // variable — see .dev.vars.example.

  "dev": { "port": 8792 }
}
